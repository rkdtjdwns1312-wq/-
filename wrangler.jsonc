{
  // wrangler 설정 파일의 형식을 검사할 때 쓰는 스키마(수정할 필요 없음)
  "$schema": "node_modules/wrangler/config-schema.json",
  // Cloudflare에 등록되는 이 Worker(프로그램)의 이름
  "name": "kokkiri",
  // 서버 코드의 시작점(진입점) 파일 경로
  "main": "dist/server/index.js",
  // Cloudflare가 이 날짜 기준의 최신 동작 방식을 사용하게 하는 값(바꿀 필요 없음)
  "compatibility_date": "2025-09-01",
  // 반드시 false로 둔다. 서버가 회원 화면용 스크립트를 client.toString()으로 페이지에 넣는데,
  // true(기본값)면 번들러가 함수 안에 __name(...) 보조 호출을 끼워 넣어 브라우저에서
  // "__name is not defined" 오류로 화면이 비어 보인다(2026-09-12 첫 배포에서 발생).
  "keep_names": false,
  // 기본 주소 https://kokkiri.<계정 하위도메인>.workers.dev 를 켠다
  "workers_dev": true,
  // 이미지 등 정적 파일을 올려두는 폴더(Workers Static Assets)
  "assets": { "directory": "./public" },
  // 이 사이트가 쓰는 D1 데이터베이스 연결 정보
  "d1_databases": [
    {
      // 서버 코드(env.DB)에서 이 이름으로 데이터베이스에 접근한다
      "binding": "DB",
      // Cloudflare 대시보드에 표시되는 데이터베이스 이름
      "database_name": "kokkiri",
      // README 3단계에서 Cloudflare가 만들어 준 D1 Database ID를 복사해 붙여넣는다
      "database_id": "33e4ab76-5b81-4677-946e-2ca4272fe211",
      // 이 폴더 안의 0000, 0001... 순서로 데이터베이스 구조를 자동으로 맞춰준다
      "migrations_dir": "drizzle"
    }
  ],
  // Cloudflare 대시보드에서 요청/오류 로그를 볼 수 있게 하는 설정
  "observability": { "enabled": true },
  // 요청 074: 주간 자동 백업. 매주 일요일 00:00(UTC)에 scheduled 핸들러가 백업을 만든다.
  "triggers": { "crons": ["0 0 * * 0"] }
}
